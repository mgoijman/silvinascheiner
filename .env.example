# ─────────────────────────────────────────────────────────────────────────────
# Silvina Scheiner Site — Environment Variables
# Copy this file to .env.local and fill in the values.
# All keys are server-side unless prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Sheets (REQUIRED to capture leads) ─────────────────────────────────
# Google Apps Script Web App URL. Get it from:
#   Extensions → Apps Script → Deploy → New deployment → Web App
SHEETS_WEBHOOK=

# ── Site URL (used for MercadoPago back URLs) ────────────────────────────────
# No trailing slash. Used server-side for MP preference back_urls.
NEXT_PUBLIC_SITE_URL=https://soysilvinascheiner.com.ar

# ── Analytics (optional — site works without these) ──────────────────────────
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (numeric, e.g. 1234567890)
NEXT_PUBLIC_META_PIXEL_ID=

# ── MercadoPago (optional — shows WhatsApp fallback if missing) ───────────────
# Get credentials from: https://www.mercadopago.com.ar/developers/panel
# IMPORTANT: Use TEST credentials locally, PRODUCTION on Vercel.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Webhook: To test locally, use ngrok:
#   ngrok http 3000
#   Then set https://xxxx.ngrok.io/api/mercadopago/webhook in your MP dashboard
#   under: Configuración → Notificaciones → Webhooks

# ── CRM (optional — no-op if missing) ────────────────────────────────────────
# Set CRM_PROVIDER to one of: hubspot | mailchimp | convertkit
# Leave empty to disable CRM sync.
CRM_PROVIDER=

# HubSpot (requires CRM_PROVIDER=hubspot)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# Mailchimp (requires CRM_PROVIDER=mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=   # e.g. us1
MAILCHIMP_AUDIENCE_ID=

# ConvertKit (requires CRM_PROVIDER=convertkit)
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ── Email delivery (optional — no-op if missing) ──────────────────────────────
# Set EMAIL_PROVIDER to one of: resend | sendgrid
# Leave empty to disable confirmation emails.
EMAIL_PROVIDER=

# Sender address and admin notification recipient
FROM_EMAIL=hola@soysilvinascheiner.com.ar
ADMIN_NOTIFICATION_EMAIL=

# Resend (requires EMAIL_PROVIDER=resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=

# SendGrid (requires EMAIL_PROVIDER=sendgrid — stub only, see lib/email.ts)
SENDGRID_API_KEY=

# ── Calendly (optional — shows OrientationForm if missing) ───────────────────
# Your Calendly scheduling URL, e.g. https://calendly.com/silvina/coaching
NEXT_PUBLIC_CALENDLY_URL=
